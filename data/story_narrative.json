  "story_scenes": {
    "new_player_arrives": {
      "id": "new_player_arrives",
      "title": "初入青石村",
      "description": "你是一名初入修仙之门的年轻修士，历经千辛万苦，终于找到了传说中的修仙村落——青石村",
      "narrative": "你沿着崎岖的山路前行，终于在夕阳西下时看到了炊烟袅袅的青石村。村口站着一位白发苍苍的老者，正笑眯眯地看着你...",
      "choices": [
        {
          "id": "choice_1",
          "text": "上前恭敬行礼",
          "effects": {
            "青云子_好感度": 10,
            "修仙知识": 5
          },
          "next_scene": "meet_elder_respectful"
        },
        {
          "id": "choice_2", 
          "text": "直接询问村长在哪",
          "effects": {
            "青云子_好感度": -5,
            "独立度": 5
          },
          "next_scene": "meet_elder_impatient"
        },
        {
          "id": "choice_3",
          "text": "观察村子四周",
          "effects": {
            "洞察力": 10,
            "青云子_好感度": 5
          },
          "next_scene": "meet_elder_observant"
        }
      ]
    },
    "meet_elder_respectful": {
      "id": "meet_elder_respectful",
      "title": "恭敬求教",
      "description": "你对老者恭敬行礼，展现出良好的修仙者素养",
      "narrative": "青云子微微点头，眼中闪过一丝赞许：\"不错，现在懂礼数的年轻人不多了。我是青石村的长老青云子，看你风尘仆仆，定是长途跋涉而来吧？\"",
      "choices": [
        {
          "id": "choice_1",
          "text": "是的，我是来求仙问道的",
          "effects": { "青云子_好感度": 5, "修仙目标": "明确" },
          "next_scene": "elder_explain_path"
        },
        {
          "id": "choice_2",
          "text": "请问这是什么地方？",
          "effects": { "青云子_好感度": 5, "修仙知识": 5 },
          "next_scene": "elder_explain_village"
        }
      ]
    },
    "meet_elder_impatient": {
      "id": "meet_elder_impatient",
      "title": "直接询问",
      "description": "你急于找到落脚之处，语气有些急切",
      "narrative": "青云子眉头微皱，但很快恢复平静：\"年轻人不要如此急躁。这青石村可是修仙界难得的净土，不是谁都能进来的。\"",
      "choices": [
        {
          "id": "choice_1",
          "text": "抱歉，我太心急了",
          "effects": { "青云子_好感度": 5, "心性": -5 },
          "next_scene": "elder_accept_apology"
        },
        {
          "id": "choice_2",
          "text": "我只是找个地方休息",
          "effects": { "青云子_好感度": -10 },
          "next_scene": "elder_cold_shoulder"
        }
      ]
    },
    "meet_elder_observant": {
      "id": "meet_elder_observant",
      "title": "细心观察",
      "description": "你注意到村口的老者气度不凡，决定先观察一番",
      "narrative": "你仔细打量着村子，发现这里看似普通，却隐隐有灵气流转。再看那老者，竟看不透其修为深浅。",
      "choices": [
        {
          "id": "choice_1",
          "text": "上前请教修仙之道",
          "effects": { "青云子_好感度": 15, "领悟力": 5 },
          "next_scene": "elder_impressed"
        }
      ]
    }
